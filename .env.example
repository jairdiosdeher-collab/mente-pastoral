# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WASAPFLOW BRIDGE CREDENTIALS (Privadas en Backend / Vercel):
# Partner Key for WasapFlow Bridge Official API (https://officialapi.wasapflow.com/bridge/v1)
WF_PARTNER_KEY=""

# Webhook Secret for HMAC SHA-256 signature verification (x-wasapflow-signature header)
WF_WEBHOOK_SECRET=""

# Port
PORT=3000

